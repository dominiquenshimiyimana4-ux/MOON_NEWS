# Base URL of the Moon News backend API.
# The frontend is API-ready: when a real backend exists, point this at it.
# While empty, the app serves realistic local sample data.
NEXT_PUBLIC_API_URL=

# Server-only backend origin used by the same-origin Next.js API proxy.
# Never expose backend credentials with NEXT_PUBLIC_ variables.
BACKEND_API_URL=

# Provisioned account e-mails are server-only in production.
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_AUTHOR_EMAIL=
NEXT_PUBLIC_ADVERTISER_EMAIL=
