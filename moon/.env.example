# Base URL of the Moon News backend API.
# The frontend is API-ready: when a real backend exists, point this at it.
# While empty, the app serves realistic local sample data.
NEXT_PUBLIC_API_URL=

# Name of the header used to send the JWT to the backend.
NEXT_PUBLIC_AUTH_TOKEN_HEADER=Authorization

# Provisioned accounts used by the local credential vault (no backend).
# Keep the real values in .env.local — never commit them.
NEXT_PUBLIC_ADMIN_NAME=
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_PASSWORD=

NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_EMAIL=
NEXT_PUBLIC_AUTHOR_PASSWORD=

NEXT_PUBLIC_ADVERTISER_NAME=
NEXT_PUBLIC_ADVERTISER_EMAIL=
NEXT_PUBLIC_ADVERTISER_PASSWORD=

# QA script (moon/qa-logins.mjs) — same accounts, used by the login check.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_AUTHOR_EMAIL=
QA_AUTHOR_PASSWORD=
QA_ADVERTISER_EMAIL=
QA_ADVERTISER_PASSWORD=
