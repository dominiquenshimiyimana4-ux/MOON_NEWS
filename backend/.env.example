# Server Configuration
PORT=5000
NODE_ENV=development

# Database (local MongoDB for development)
MONGODB_URI=mongodb://127.0.0.1:27017/moon-news
# For Atlas, replace this with the complete connection string from Atlas.
# URL-encode special characters in the database username and password.
# MONGODB_URI=mongodb+srv://<db_user>:<URL-encoded-db-password>@<cluster-host>/moon-news?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=<a-long-random-secret>
JWT_EXPIRE=7d

# Email Configuration (for newsletters)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Mobile Money, Card, etc.)
PAYMENT_GATEWAY_URL=
PAYMENT_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Provisioned accounts (admin, author, advertiser)
# Only the bcrypt hash of each password is ever written to the database.
# Run `npm run provision:auth` (or `npm run admin:credentials`) after changing these values.
ADMIN_NAME=<admin display name>
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<strong admin password>

AUTHOR_NAME=<author display name>
AUTHOR_EMAIL=<author email>
AUTHOR_PASSWORD=<author password>

ADVERTISER_NAME=<advertiser display name>
ADVERTISER_EMAIL=<advertiser email>
ADVERTISER_PASSWORD=<advertiser password>
