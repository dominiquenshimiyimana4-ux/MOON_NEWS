# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Local:    mongodb://localhost:27017/moon-news
# Atlas:    mongodb+srv://<db_user>:<db_password>@cluster0.rwlwyt3.mongodb.net/moon-news?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.rwlwyt3.mongodb.net/moon-news?retryWrites=true&w=majority
MONGODB_USER=<db_user>
MONGODB_PASSWORD=<db_password>

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for newsletters)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Mobile Money, Card, etc.)
PAYMENT_GATEWAY_URL=
PAYMENT_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
